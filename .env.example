# Copy this file to .env and fill in your own values.
# .env is ignored by Git - never commit real keys.

# Key from https://build.nvidia.com
NVIDIA_API_KEY=

# Key from https://tavily.com (web search)
TAVILY_API_KEY=

# Optional: key from https://aistudio.google.com (not used in v1)
GEMINI_API_KEY=

# Optional: other NVIDIA models (defaults: openai/gpt-oss-20b for extraction,
# nvidia/nemotron-3.5-lightning-30b-a3b for the chat)
# NVIDIA_MODEL=
# NVIDIA_CHAT_MODEL=

# Optional: your first name for the greeting on the start page
USER_NAME=

# Nominatim needs an app name with contact info, e.g. "searchbrain/0.1 (your@email)"
NOMINATIM_USER_AGENT=
