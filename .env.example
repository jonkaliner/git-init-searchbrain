# Copy this file to .env and fill in your own values.
# .env is ignored by Git - never commit real keys. (On GitHub the same keys are "secrets", see README.md.)

# Needed. Key from https://build.nvidia.com
NVIDIA_API_KEY=

# Needed. Nominatim (place name -> map position) wants an app name, e.g. "searchbrain/0.1 (private learning project)"
NOMINATIM_USER_AGENT=

# Optional: backup web search for when DuckDuckGo refuses to answer. Key from https://tavily.com
TAVILY_API_KEY=
# Optional: SEARCH_PROVIDER=tavily searches with Tavily only (default: duckduckgo)
# SEARCH_PROVIDER=

# Optional: other NVIDIA models. NVIDIA_CHAT_MODEL is the one the two agents use (default nvidia/nemotron-3.5-lightning-30b-a3b),
# NVIDIA_MODEL reads web pages for the plain collect command (default openai/gpt-oss-20b)
# NVIDIA_MODEL=
# NVIDIA_CHAT_MODEL=
